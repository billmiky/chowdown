---
---
[
  {% for post in site.recipes %}
    {
      "title"        : {{ post.title | jsonify }},
      {% if post.ingredients %}"ingredients" : {{ post.ingredients | join: ", " | jsonify }},{% endif %}
      {% if post.tags %}"tags"        : {{ post.tags | join: " " | jsonify }},{% endif %}
      {% if post.season %}"season"      : {{ post.season | join: " " | jsonify }},{% endif %}
      {% if post.cook_time %}"cook_time"   : {{ post.cook_time | jsonify }},{% endif %}
      {% if post.total_time %}"total_time"  : {{ post.total_time | jsonify }},{% endif %}
      "slug"         : {{ post.path | remove: '_recipes/' | remove: '.md' | jsonify }},
      "last_made"    : "{{ post.last_made }}",
      "rating"       : {{ post.rating | plus: 0 }},
      "kid_friendly" : "{{ post.kid_friendly }}",
      "category"     : {{ post.category | default: "" | jsonify }},
      "difficulty"   : {{ post.difficulty | default: "" | jsonify }},
      "image"        : {{ site.baseurl | append: '/images/' | append: post.image | jsonify }},
      "url"          : {{ site.baseurl | append: post.url | jsonify }},
      "description"  : {{ post.content | strip_html | strip_newlines | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
